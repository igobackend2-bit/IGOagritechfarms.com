# Gmail account that sends the mail (must have an App Password generated —
# regular account passwords do not work with SMTP).
GMAIL_USER=igoagritechfarms@gmail.com
GMAIL_APP_PASSWORD=

# Fixed recipient — kept server-side so this endpoint can't be abused as an open relay.
MAIL_TO=igoagritechfarms@gmail.com

# Comma-separated list of origins allowed to call this service.
ALLOWED_ORIGINS=https://www.igoagritechfarms.com,https://igoagritechfarms.com

PORT=3001
